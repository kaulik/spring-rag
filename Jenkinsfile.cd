// CD pipeline: blue-green deploy of a myapp image built by the CI job.
//
// Deploys INSTANCE_COUNT containers to the idle color's port range, health-
// checks each, then regenerates nginx's spring-rag upstream file and reloads —
// traffic flips atomically. The previously live color keeps running for
// instant rollback (re-run with SWITCH_ONLY=true and TARGET_COLOR=<old color>).
//
// Port plan: blue = 8585..  green = 8590..  (keep clear of 8686 config server,
// 8484 jenkins, 8383 weaviate, 11434 ollama, 4318 otel).
pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'myapp image tag to deploy (set by the CI job)'
        )
        choice(
            name: 'TARGET_COLOR',
            choices: ['auto', 'blue', 'green'],
            description: 'auto = deploy to the color that is NOT currently live'
        )
        choice(
            name: 'SPRING_PROFILE',
            choices: ['prod', 'dev'],
            description: 'Spring profile — selects spring-rag-<profile>.yml overrides from config-repo'
        )
        string(
            name: 'INSTANCE_COUNT',
            defaultValue: '2',
            description: 'Containers per color'
        )
        booleanParam(
            name: 'SWITCH_ONLY',
            defaultValue: false,
            description: 'Skip deployment; just point nginx at TARGET_COLOR (instant rollback — containers must already be running)'
        )
        booleanParam(
            name: 'RETIRE_OLD_COLOR',
            defaultValue: false,
            description: 'Stop the old color after the switch (default keeps it running for rollback)'
        )
        string(
            name: 'NGINX_CONTAINER',
            defaultValue: 'nginx_web',
            description: 'Name of the nginx load-balancer container'
        )
    }

    environment {
        BLUE_BASE_PORT  = '8585'
        GREEN_BASE_PORT = '8590'
        UPSTREAM_CONF   = '/etc/nginx/conf.d/spring-rag-upstream.conf'
    }

    stages {

        stage('Determine colors') {
            steps {
                script {
                    def live = sh(
                        returnStdout: true,
                        script: "docker exec ${params.NGINX_CONTAINER} sh -c \"grep -o 'color=[a-z]*' ${env.UPSTREAM_CONF} 2>/dev/null | cut -d= -f2\" || true"
                    ).trim()
                    env.LIVE_COLOR = live ?: 'none'

                    if (params.TARGET_COLOR == 'auto') {
                        env.TARGET = (env.LIVE_COLOR == 'blue') ? 'green' : 'blue'
                    } else {
                        env.TARGET = params.TARGET_COLOR
                    }
                    env.TARGET_BASE_PORT = (env.TARGET == 'blue') ? env.BLUE_BASE_PORT : env.GREEN_BASE_PORT

                    echo "live=${env.LIVE_COLOR}  target=${env.TARGET}  basePort=${env.TARGET_BASE_PORT}  image=myapp:${params.IMAGE_TAG}"
                    if (env.TARGET == env.LIVE_COLOR && !params.SWITCH_ONLY) {
                        echo 'WARNING: deploying onto the LIVE color — requests may fail during container restarts'
                    }
                }
            }
        }

        stage('Deploy target color') {
            when { expression { !params.SWITCH_ONLY } }
            steps {
                withCredentials([
                    string(credentialsId: 'WEAVIATE_API_KEY', variable: 'WEAVIATE_API_KEY'),
                    string(credentialsId: 'API_KEY',          variable: 'API_KEY'),
                    string(credentialsId: 'STOCK_API_KEY',    variable: 'STOCK_API_KEY')
                ]) {
                    sh """
                        # Remove legacy uncolored containers from the pre-blue-green setup
                        for legacy in myapp spring-rag-1 spring-rag-2 spring-rag-3; do
                            docker stop \$legacy 2>/dev/null || true
                            docker rm   \$legacy 2>/dev/null || true
                        done

                        i=1
                        while [ \$i -le ${params.INSTANCE_COUNT} ]; do
                            PORT=\$(( ${env.TARGET_BASE_PORT} + i - 1 ))
                            NAME=spring-rag-${env.TARGET}-\$i

                            docker stop \$NAME 2>/dev/null || true
                            docker rm   \$NAME 2>/dev/null || true
                            docker ps -q  --filter publish=\$PORT | xargs -r docker stop
                            docker ps -aq --filter publish=\$PORT | xargs -r docker rm

                            docker run -d \
                              --name \$NAME \
                              --hostname \$NAME \
                              -p \$PORT:8080 \
                              -e WEAVIATE_API_KEY=\$WEAVIATE_API_KEY \
                              -e RAG_WEAVIATE_API_KEY=\$WEAVIATE_API_KEY \
                              -e API_KEY=\$API_KEY \
                              -e STOCK_API_KEY=\$STOCK_API_KEY \
                              -e OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318 \
                              -e OTEL_RESOURCE_ATTRIBUTES="service.instance.id=\$NAME,service.namespace=spring-rag,host.name=\$NAME,service.version=${params.IMAGE_TAG},deployment.color=${env.TARGET}" \
                              -e CONFIG_SERVER_URL=http://host.docker.internal:8686 \
                              -e SPRING_PROFILES_ACTIVE=${params.SPRING_PROFILE} \
                              -e JAVA_TOOL_OPTIONS="-Xmx768m" \
                              --add-host=host.docker.internal:host-gateway \
                              --add-host=ollama:host-gateway \
                              --add-host=weaviate:host-gateway \
                              -e BUILD_ID=${params.IMAGE_TAG} \
                              --restart unless-stopped \
                              myapp:${params.IMAGE_TAG}

                            # Health gate — runs inside the app container (busybox wget);
                            # the Jenkins agent is a container and can't reach host ports.
                            t=1
                            until docker exec \$NAME wget -qO /dev/null http://localhost:8080/actuator/health; do
                                if [ \$t -ge 30 ]; then
                                    echo "\$NAME failed to become healthy on port \$PORT"
                                    docker logs --tail 100 \$NAME || true
                                    exit 1
                                fi
                                t=\$(( t + 1 ))
                                sleep 2
                            done
                            echo "\$NAME healthy on port \$PORT"

                            i=\$(( i + 1 ))
                        done
                    """
                }
            }
        }

        stage('Switch traffic') {
            steps {
                script {
                    int base  = env.TARGET_BASE_PORT as int
                    int count = params.INSTANCE_COUNT as int
                    def servers = (0..<count).collect { n ->
                        "    server host.docker.internal:${base + n} max_fails=3 fail_timeout=10s;"
                    }.join('\n')
                    writeFile file: 'spring-rag-upstream.conf', text: """\
# Generated by spring-rag-cd build ${env.BUILD_NUMBER} — do not edit by hand. color=${env.TARGET}
upstream spring_rag {
    least_conn;
${servers}
    keepalive 32;
}
"""
                    // conf.d is often a read-only bind mount inside the nginx
                    // container, which makes docker cp fail. Find the host path
                    // backing the upstream file and write there instead — the
                    // host side of a :ro mount is writable and nginx sees it.
                    def mounts = sh(
                        returnStdout: true,
                        script: "docker inspect ${params.NGINX_CONTAINER} --format '{{range .Mounts}}{{.Destination}}|{{.Source}}{{\"\\n\"}}{{end}}'"
                    ).trim()
                    def target = env.UPSTREAM_CONF
                    def best = null
                    mounts.split('\n').findAll { it.contains('|') }.each { line ->
                        def (dest, src) = line.split('\\|').toList()
                        if ((target == dest || target.startsWith(dest + '/')) &&
                            (best == null || dest.length() > best[0].length())) {
                            best = [dest, src]
                        }
                    }
                    env.UPSTREAM_HOST_FILE = best
                        ? best[1] + (target == best[0] ? '' : target.substring(best[0].length()))
                        : ''
                }
                sh """
                    if [ -n "\$UPSTREAM_HOST_FILE" ]; then
                        echo "conf.d is bind-mounted — writing via host path \$UPSTREAM_HOST_FILE"
                        docker run --rm -i -v "\$(dirname "\$UPSTREAM_HOST_FILE"):/confd" alpine \
                            sh -c "cat > /confd/\$(basename "\$UPSTREAM_HOST_FILE")" < spring-rag-upstream.conf
                    else
                        docker cp spring-rag-upstream.conf ${params.NGINX_CONTAINER}:${env.UPSTREAM_CONF}
                    fi
                    docker exec ${params.NGINX_CONTAINER} nginx -t
                    docker exec ${params.NGINX_CONTAINER} nginx -s reload
                    echo "Traffic switched to ${env.TARGET}"
                """
            }
        }

        stage('Retire old color') {
            when {
                expression {
                    params.RETIRE_OLD_COLOR &&
                    env.LIVE_COLOR in ['blue', 'green'] &&
                    env.LIVE_COLOR != env.TARGET
                }
            }
            steps {
                build job: 'spring-rag-cleanup',
                      wait: false,
                      parameters: [
                          string(name: 'COLOR', value: env.LIVE_COLOR)
                      ]
                echo "Triggered spring-rag-cleanup for color ${env.LIVE_COLOR} (containers kept for docker start rollback)"
            }
        }
    }

    post {
        success {
            echo "Deployed myapp:${params.IMAGE_TAG} to ${env.TARGET}; nginx now routes /spring-rag to it. Rollback: re-run with SWITCH_ONLY=true, TARGET_COLOR=${env.LIVE_COLOR}"
        }
        failure {
            echo "CD failed. nginx was NOT switched unless the 'Switch traffic' stage ran — previous color ${env.LIVE_COLOR} is still serving."
        }
    }
}
